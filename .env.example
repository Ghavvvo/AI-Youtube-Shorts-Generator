# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai or gemini
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
# OpenAI-compatible base URL. DeepSeek: descomenta y usa OPENAI_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output

# Subtítulos quemados (stage local, 3 palabras por bloque)
LOCAL_SUBTITLE_WORDS=3

# Upload a Zernio (stage local, se activa con --upload)
ZERNIO_API_KEY=your_zernio_key_here
ZERNIO_BASE_URL=https://zernio.com/api/v1
ZERNIO_PLATFORM=youtube      # youtube | instagram
ZERNIO_PUBLISH_NOW=false     # true = publicar directo, false = borrador
ZERNIO_ACCOUNT_YOUTUBE=
ZERNIO_ACCOUNT_INSTAGRAM=
